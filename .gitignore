# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw demo images (only optimized versions are needed)
public/images/demo/

# Brand reference assets (large PDFs + source files kept local only)
/assets/

# original (uncompressed) media — preserved locally, never committed
media/originals/
public/videos/*-original.mp4

# local media backups — physical copies kept to restore design assets without
# git, deliberately excluded from the build so duplicates don't ship to Vercel
/backups/

# Font purchase source materials (license proofs, original kits, .otf desktop
# files). Shipped webfonts live in src/app/fonts/ and DO get committed.
# This root /fonts/ folder is the raw archive of what the foundry sent us.
/fonts/

.vercel
